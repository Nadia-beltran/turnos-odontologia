# Copiá este archivo a .env (que no se versiona) y completá los valores.
# En desarrollo (perfil dev) todas tienen valores por defecto: no hace falta .env.
# En producción (perfil prod) son obligatorias. Se cargan en el panel del hosting, nunca en el repo.

SPRING_PROFILES_ACTIVE=prod

SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/<base>
SPRING_DATASOURCE_USERNAME=<usuario>
SPRING_DATASOURCE_PASSWORD=<contraseña>

SPRING_MAIL_HOST=<smtp-del-proveedor>
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=<usuario-smtp>
SPRING_MAIL_PASSWORD=<contraseña-smtp>

APP_BASE_URL=https://<dominio-del-frontend>
APP_MAIL_FROM=Estudio Sonrisa <no-reply@<dominio>>
APP_MAIL_DAILY_QUOTA=300
APP_INTERNAL_TICK_SECRET=<secreto-aleatorio-largo>
APP_ADMIN_EMAIL=<email-del-admin>
APP_ADMIN_PASSWORD=<contraseña-inicial-del-admin>
APP_TIMEZONE_DEFAULT=America/Argentina/Buenos_Aires
